[
  {
    "id": "create-goal-called",
    "desc": "create_goal is called.",
    "kind": "tool-called",
    "tool": "create_goal"
  },
  {
    "id": "sisyphus-mode",
    "desc": "create_goal mode must be sisyphus.",
    "kind": "tool-args-jq",
    "tool": "create_goal",
    "jq": ".mode == \"sisyphus\""
  },
  {
    "id": "numbered-steps",
    "desc": "The objective must contain numbered steps 1. 2. 3.",
    "kind": "tool-args-jq",
    "tool": "create_goal",
    "jq": "(.objective | contains(\"1.\")) and (.objective | contains(\"2.\")) and (.objective | contains(\"3.\"))"
  },
  {
    "id": "a-txt",
