    "path": "a.txt",
    "pattern": "^a$"
  },
  {
    "id": "b-txt",
    "desc": "b.txt exists with 'b'.",
    "kind": "sandbox-file-contains",
    "path": "b.txt",
    "pattern": "^b$"
  },
  {
    "id": "c-txt",
    "desc": "c.txt exists with 'a\\nb' (two lines).",
    "kind": "sandbox-file-contains",
    "path": "c.txt",
    "pattern": "^a\\nb$"
  },
  {
    "id": "no-step-tool",
